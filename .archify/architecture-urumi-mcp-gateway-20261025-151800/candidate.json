  "cards": [
    {
      "dot": "cyan",
      "title": "Unified Team MCP Gateway",
      "items": [
        "Aggregates 3 upstream MCP servers (10 tools total) behind a single Streamable HTTP endpoint (/mcp)",
        "Deterministic namespacing (woocommerce_*, weather_*, shipping_*, customer_notes_*)",
        "Fault-isolated queries via Promise.allSettled with 5-8s circuit breaker timeouts"
      ]
    },
    {
      "dot": "rose",
      "title": "Zero-Trust Security & RBAC",
      "items": [
        "Two-tier RBAC: Alice (Admin) and Bob (Member) with isolated permissions",
        "Instant revocation: API keys hashed with SHA-256; checked against PostgreSQL in real-time",
        "SSRF guardrails reject cloud metadata (169.254.169.254), loopback, and K8s control plane"
      ]
    },
    {
      "dot": "emerald",
      "title": "Kubernetes & Production Readiness",
      "items": [
        "Dual isolated namespaces (urumi-store and urumi-gateway) protected by NetworkPolicies",
        "Hardened containers running as non-root (UID 1000) with read-only root filesystems and dropped capabilities",
        "Identical Helm charts deploy to local Kind and VPS k3s purely via values files"
      ]
    }
  ]
